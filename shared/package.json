    "./config/types": "./src/config/types.ts",
    "./config/defaults": "./src/config/defaults.ts",
    "./config/normalize": "./src/config/normalize.ts",
    "./config/textos": "./src/config/textos.ts",
    "./lib/color": "./src/lib/color.ts",
    "./lib/hours": "./src/lib/hours.ts",
    "./lib/texto": "./src/lib/texto.ts",
    "./lib/whatsapp": "./src/lib/whatsapp.ts"
