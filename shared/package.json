{
  "name": "@barbearia/shared",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Base comum dos dois módulos: schema do barbearia.config.json e utilitários de cor, horário e WhatsApp.",
  "exports": {
    ".": "./src/index.ts",
