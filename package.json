{
  "name": "white-label-restaurante",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Landing page white-label de restaurante + reserva de mesas pelo WhatsApp, em dois módulos independentes.",
  "workspaces": [
    "shared",
    "site",
    "whatsapp"
  ],
  "scripts": {
    "dev": "npm run dev -w @restaurante/site",
    "build": "npm run build -w @restaurante/site",
    "preview": "npm run preview -w @restaurante/site",

    "dev:whatsapp": "npm run dev -w @restaurante/whatsapp",
    "start:whatsapp": "npm run start -w @restaurante/whatsapp",

    "deploy:check": "node deploy/verificar-tenants.mjs",

    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
