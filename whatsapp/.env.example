# ==============================================================================
#  RESTAURANTE — INTEGRAÇÃO WHATSAPP BUSINESS PLATFORM (CLOUD API)
# ==============================================================================
#
#  COMO USAR
#  ---------
#  Todos os comandos abaixo rodam de dentro de whatsapp/ (o módulo da
#  automação). Da raiz do repositório: npm run <script> -w @restaurante/whatsapp
#
#  1. Copie este arquivo:            cp .env.example .env
#  2. Preencha o que está marcado com  (OBRIGATÓRIO)
#  3. Suba o banco e as tabelas:      npm run db:migrate
#  4. Cadastre o restaurante:         npm run tenant:sync
#  5. Rode o servidor:                npm run dev
#
#  O arquivo .env NUNCA vai para o git (já está no .gitignore). O token da Meta
#  é a chave da sua conta de WhatsApp: quem tiver ele manda mensagem no seu nome.
#
#  O passo a passo de onde clicar no painel da Meta está em docs/setup.md.
#
# ==============================================================================


# ------------------------------------------------------------------------------
#  1. SERVIDOR
# ------------------------------------------------------------------------------

# Ambiente: "development" no seu computador, "production" no servidor de verdade.
# Em production o servidor recusa subir com configuração insegura (ex.: sem
# assinatura de webhook), então não mude isso só para "fazer funcionar".
NODE_ENV=development

# Porta em que a API escuta.
PORT=3333

# Endereço público e HTTPS onde este servidor responde. É o que você cadastra na
# Meta como URL do webhook (a Meta só aceita HTTPS, nunca http:// nem IP).
# Em desenvolvimento, use um túnel: npx cloudflared tunnel --url http://localhost:3333
# (OBRIGATÓRIO em produção)
PUBLIC_URL=https://bot.seurestaurante.com.br

# Detalhe do log: fatal | error | warn | info | debug | trace
# Use "debug" para ver o payload das mensagens enquanto desenvolve.
LOG_LEVEL=info


# ------------------------------------------------------------------------------
#  2. BANCO DE DADOS (PostgreSQL 14+)
# ------------------------------------------------------------------------------

# Conexão completa. Para desenvolver, o docker-compose.yml deste repositório já
# sobe um Postgres pronto com exatamente esta URL:
#     docker compose up -d
# (OBRIGATÓRIO)
DATABASE_URL=postgres://restaurante:restaurante@localhost:5432/restaurante

# SSL na conexão. "false" no Postgres local; a maioria dos bancos gerenciados
# (Neon, Supabase, Railway, RDS) exige "true".
DATABASE_SSL=false

# Máximo de conexões simultâneas no pool. 10 aguenta bem vários restaurantes.
# Bancos gerenciados no plano gratuito costumam limitar em 20 no total.
DATABASE_POOL_MAX=10

# Banco usado pelos testes de integração. Se ficar vazio, esses testes são
# PULADOS (os testes de lógica pura rodam de qualquer jeito).
DATABASE_URL_TEST=


# ------------------------------------------------------------------------------
#  3. APLICATIVO DA META
# ------------------------------------------------------------------------------
#  Um aplicativo só atende TODOS os restaurantes. O que muda de um para outro é o
#  número de telefone (phone_number_id), que fica no banco — não aqui.
#
#  Onde achar: developers.facebook.com → Meus aplicativos → seu app
# ------------------------------------------------------------------------------

# Configurações do app → Básico → "ID do aplicativo"
# (OBRIGATÓRIO)
META_APP_ID=

# Configurações do app → Básico → "Chave secreta do aplicativo" → Mostrar.
# É com ela que o servidor confere a assinatura (X-Hub-Signature-256) e garante
# que o webhook veio mesmo da Meta, e não de alguém fingindo ser ela.
# (OBRIGATÓRIO)
META_APP_SECRET=

# Senha que VOCÊ inventa. Você digita o mesmo valor aqui e no painel da Meta, em
# WhatsApp → Configuração → Webhook → "Verificar token". A Meta devolve esse
# valor ao cadastrar a URL, e o servidor compara.
# Gere uma boa com:  openssl rand -hex 32
# (OBRIGATÓRIO)
META_VERIFY_TOKEN=

# Versão da Graph API. Suba de versão de propósito, testando — a Meta aposenta
# versões antigas com aviso prévio.
META_GRAPH_VERSION=v21.0

# Endereço da Graph API. Só mude para apontar para um mock nos testes.
META_API_BASE_URL=https://graph.facebook.com

# Tempo limite (ms) de cada chamada à Meta antes de desistir e tentar de novo.
META_TIMEOUT_MS=15000


# ------------------------------------------------------------------------------
#  4. SEGURANÇA
# ------------------------------------------------------------------------------

# Chave que criptografa os tokens dos restaurantes guardados no banco (AES-256-GCM).
# 32 bytes em base64. Gere com:  openssl rand -base64 32
#
# ⚠️  Se você perder ou trocar esta chave, os tokens já salvos viram lixo e cada
#     restaurante precisa ser cadastrado de novo. Guarde junto do backup do banco.
# (OBRIGATÓRIO)
APP_ENCRYPTION_KEY=

# Senha das rotas administrativas (/admin/*). Enviada como:
#     Authorization: Bearer <valor>
# Gere com:  openssl rand -hex 32
# (OBRIGATÓRIO)
ADMIN_API_TOKEN=


# ------------------------------------------------------------------------------
#  5. PADRÕES REGIONAIS
# ------------------------------------------------------------------------------

# Fuso usado para montar as reservas e disparar os lembretes. Cada restaurante pode
# ter o seu (campo "timezone" do tenant); este é o padrão de quem não definir.
DEFAULT_TIMEZONE=America/Sao_Paulo

# Idioma dos templates aprovados na Meta. O nome do idioma precisa ser
# EXATAMENTE o mesmo cadastrado lá, senão o envio falha com erro 132001.
DEFAULT_LOCALE=pt_BR

# DDI acrescentado a números escritos sem código do país (55 = Brasil).
DEFAULT_COUNTRY_CODE=55


# ------------------------------------------------------------------------------
#  6. WORKER DAS MENSAGENS PROGRAMADAS
# ------------------------------------------------------------------------------
#  É ele que envia lembretes e avisos na hora certa. Sem worker rodando,
#  o bot conversa normalmente mas NENHUM lembrete sai.
# ------------------------------------------------------------------------------

# Liga o worker. "false" só se você for rodá-lo em outro processo/servidor.
WORKER_ENABLED=true

# "true"  = worker dentro do mesmo processo da API (deploy de 1 container, mais barato)
# "false" = processo separado, iniciado com  npm run worker  (melhor sob volume alto)
WORKER_IN_PROCESS=true

# De quanto em quanto tempo (ms) o worker procura mensagens para enviar.
# 30s dá precisão de sobra para lembretes e não pesa no banco.
WORKER_INTERVAL_MS=30000

# Quantas mensagens ele envia por rodada.
WORKER_BATCH_SIZE=20

# Quantas vezes tentar de novo antes de desistir de uma mensagem. As tentativas
# são espaçadas (1min, 2min, 4min, 8min...). Erros definitivos da Meta — número
# inválido, template reprovado — não são retentados, mesmo com tentativas sobrando.
OUTBOX_MAX_ATTEMPTS=5

# Varredura diária (hora local do restaurante) que monta as mensagens de
# reativação e aniversário do dia, fecha as reservas que já passaram e expira
# os pedidos de grupo grande que o dono não respondeu a tempo. Formato HH:MM.
DAILY_JOBS_AT=09:00


# ------------------------------------------------------------------------------
#  7. MENSAGENS PROGRAMADAS — LIGA E DESLIGA
# ------------------------------------------------------------------------------
#  Trava GERAL, do servidor inteiro. Cada restaurante ainda pode desligar a dele
#  em "whatsapp.messages" no restaurante.config.json.
#
#  Uma mensagem só é enviada se estiver ligada NOS DOIS lugares.
# ------------------------------------------------------------------------------

# A confirmação da reserva não tem flag: ela é a resposta imediata ao toque
# em "Confirmar", sai na hora com todos os detalhes e não passa pela fila.

# Lembrete na véspera, com botões "Confirmo" e "Cancelar".
# Precisa do template aprovado (categoria UTILITY).
FEATURE_LEMBRETE_24H=true

# Lembrete 2h antes. Também precisa de template aprovado.
FEATURE_LEMBRETE_2H=true

# --- Abaixo: implementadas e DESLIGADAS. Ligue uma de cada vez, depois que o
# --- template correspondente estiver aprovado na Meta.

# Agradecimento depois da visita, com botão para avaliar no Google.
# Exige "whatsapp.reviewUrl" preenchido no config do restaurante.
FEATURE_POS_ATENDIMENTO=false

# Convite para voltar, ao cliente que sumiu há N dias (whatsapp.reativacaoDias).
# ⚠️  Template de MARKETING: só vai para quem deu opt-in explícito, tem limite
#     por pessoa imposto pela Meta e é o mais caro. Ligue com consciência.
FEATURE_REATIVACAO=false

# Parabéns no aniversário. Só funciona para quem informou a data no bot.
# Também é MARKETING.
FEATURE_ANIVERSARIO=false


# ------------------------------------------------------------------------------
#  8. NOMES DOS TEMPLATES APROVADOS NA META
# ------------------------------------------------------------------------------
#  Os nomes precisam bater LETRA POR LETRA com os cadastrados no WhatsApp Manager
#  (só minúsculas, números e _). O JSON de cada um está em
#  docs/templates.md — é só colar lá e enviar para aprovação.
#
#  Confira o que já está aprovado com:  npm run templates:check
# ------------------------------------------------------------------------------

TEMPLATE_LEMBRETE_24H=lembrete_24h
TEMPLATE_LEMBRETE_2H=lembrete_2h
TEMPLATE_POS_ATENDIMENTO=pos_atendimento
TEMPLATE_REATIVACAO=reativacao_cliente
TEMPLATE_ANIVERSARIO=aniversario_cliente


# ------------------------------------------------------------------------------
#  9. COMPORTAMENTO DA CONVERSA
# ------------------------------------------------------------------------------

# Quando o cliente pede "Falar com atendente", o bot cala a boca nessa conversa
# por estes minutos, para não atropelar a pessoa que está respondendo.
HANDOFF_MINUTES=30

# Se o cliente parar no meio da reserva e voltar depois deste tempo (minutos),
# o bot recomeça do menu em vez de continuar de um passo que ele já esqueceu.
SESSION_TIMEOUT_MIN=20

# Silêncio noturno: nada programado é enviado nesta faixa (hora local do
# restaurante). O que cairia aqui é adiado para o horário de término.
# Não vale para a confirmação imediata — essa é resposta a uma ação do cliente.
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00

# Freio contra enxurrada: máximo de mensagens que um mesmo cliente pode disparar
# por minuto. Acima disso o bot ignora, sem responder.
# Uma reserva leva por volta de 7 toques, então não desça muito daqui: quem
# reserva, cancela e remarca na mesma conversa passa fácil de 20.
RATE_LIMIT_PER_CONTACT_PER_MIN=40

# Quantos dias guardar o conteúdo das mensagens no banco (LGPD: guardar só o
# necessário). Depois disso o texto é apagado e fica só o registro estatístico.
# 0 = nunca apagar.
MESSAGE_RETENTION_DAYS=180


# ------------------------------------------------------------------------------
#  10. PRIMEIRO RESTAURANTE (bootstrap)
# ------------------------------------------------------------------------------
#  Preencha para cadastrar o primeiro restaurante direto pelo .env — o
#  "npm run tenant:sync" cria/atualiza ele no banco.
#
#  Do segundo em diante, cadastre com:
#      npm run tenant:add -- --slug=outro-restaurante
#  (os dados vão criptografados para o banco e o .env continua enxuto)
# ------------------------------------------------------------------------------

# Identificador curto, só letras minúsculas, números e hífen. Precisa ser o mesmo
# nome da pasta em tenants/<slug>/restaurante.config.json
TENANT_SLUG=cantina-bella-nonna

# WhatsApp → Configuração da API → "Identificação do número de telefone".
# É por este número que o servidor descobre de qual restaurante é cada mensagem.
# ⚠️  NÃO é o número de telefone: é um ID numérico longo, tipo 123456789012345.
TENANT_PHONE_NUMBER_ID=

# WhatsApp → Configuração da API → "Identificação da conta do WhatsApp Business".
# Usado para listar e conferir os templates.
TENANT_WABA_ID=

# Token de acesso. Para produção use um token PERMANENTE, de usuário do sistema
# (Meta Business → Configurações → Usuários do sistema → Gerar novo token, com
# as permissões whatsapp_business_messaging e whatsapp_business_management).
# O token de teste que aparece no painel expira em 24 horas.
TENANT_ACCESS_TOKEN=

# WhatsApp do dono do restaurante, que recebe os avisos de reserva (e os
# pedidos de grupo grande para aprovar) e tem o painel do dono (reservas do
# dia, relatório, fechar agenda, pausar o bot).
# Pode escrever de qualquer jeito: (11) 91234-5678 ou 5511912345678.
#
# BOOTSTRAP APENAS. Quem manda no número do dono é o `whatsapp.owner.phones` do
# restaurante.config.json, editável no estúdio: preenchido lá, ele vence esta
# variável no próximo `tenant:sync`. Esta aqui só resolve o ovo-e-galinha da
# primeira instalação, quando ainda não há config sincronizado.
#
# O telefone da recepção não tem variável nenhuma: é o `team[].phone` do
# config, e é ele que abre o painel da recepção.
TENANT_OWNER_PHONE=

# Fuso deste restaurante. Vazio = usa o DEFAULT_TIMEZONE.
TENANT_TIMEZONE=
