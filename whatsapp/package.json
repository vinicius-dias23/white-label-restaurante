{
  "name": "@restaurante/whatsapp",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Módulo 2 — automação de atendimento no WhatsApp (Cloud API + Fastify + PostgreSQL).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/migrate.ts --reset",
    "tenant:sync": "tsx src/tenants/cli.ts sync",
    "tenant:add": "tsx src/tenants/cli.ts add",
    "tenant:list": "tsx src/tenants/cli.ts list",
    "bot:sim": "tsx src/bot/sim-cli.ts",
    "textos:studio": "tsx src/studio/server.ts",
    "templates:check": "tsx src/whatsapp/templates-check.ts",
    "wa:send": "tsx src/whatsapp/send-cli.ts",
    "outbox:run": "tsx src/scheduler/run-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@restaurante/shared": "*",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
